# ==============================================================================
# SZABLON KONFIGURACJI - PPLv2
# Nie edytuj tego pliku bezpośrednio! Uruchom skrypt ./setup.sh, 
# który przeprowadzi Cię przez proces i wygeneruje poprawny plik .env.
# ==============================================================================

# --- ZABEZPIECZENIA ---
# SECRET_KEY: 50-znakowy, losowy ciąg. Używany do szyfrowania sesji i ciasteczek.
SECRET_KEY=
# DEBUG: True dla testów lokalnych (wyświetla błędy). False dla produkcji!
DEBUG=
# ALLOWED_HOSTS: Domeny lub adresy IP, z których można wchodzić (np. localhost,192.168.1.10)
ALLOWED_HOSTS=
# CSRF_TRUSTED_ORIGINS: Zaufane adresy z protokołem dla formularzy (np. http://localhost)
CSRF_TRUSTED_ORIGINS=

# --- BAZA DANYCH (POSTGRESQL) ---
USE_POSTGRES=True
DB_HOST=db
POSTGRES_DB=pplv2_db
POSTGRES_USER=pplv2_user
POSTGRES_PASSWORD=

# --- POCZTA EMAIL (SMTP) ---
# Użyj 'django.core.mail.backends.console.EmailBackend' dla testów lokalnych
# Użyj 'django.core.mail.backends.smtp.EmailBackend' dla produkcji
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- CACHE & RATE LIMITING (REDIS) ---
# Adres serwera Redis (np. redis://127.0.0.1:6379/1 dla lokalnego, redis://redis:6379/1 dla Dockera)
REDIS_URL=

# --- KOPIE ZAPASOWE (GOOGLE CLOUD STORAGE) ---
# Opcjonalne: Uzupełnij, jeśli system wykonuje backupy do chmury Google
GS_BUCKET_NAME=
GS_PROJECT_ID=


# --- SENTRY ---
# Opcjonalne: Adres DSN do śledzenia błędów w aplikacji
SENTRY_DSN=

# --- DODATKOWE USTAWIENIA ---
ADMIN_URL='adm/in/'
RODO_RETENTION_DAYS=


# ==============================================================================
# AKTUALIZACJE I WERSJONOWANIE (WATCHTOWER)
# ==============================================================================
# Wersja aplikacji: 'stable' (produkcja) lub 'beta' (testy)
APP_VERSION=

# Aby włączyć automatyczne aktualizacje, ustaw na: auto-update
COMPOSE_PROFILES=

# Jak często Watchtower ma sprawdzać nowe wersje (w sekundach, np. 3600 = 1h, 300 = 5m)
WATCHTOWER_POLL_INTERVAL=